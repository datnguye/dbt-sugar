{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:ui:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Read(./**)",
      "Bash(npm run verify)",
      "Bash(npm run ux:shots)",
      "Bash(npm run spec-guard*)",
      "Bash(npm run playground*)",
      "Bash(npx playwright test*)",
      "Bash(node src/bin/sugar.js *)",
      "Bash(node test/playground/run.js *)",
      "Bash(node src/scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh run *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-js.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-guard.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/plugins/marketplaces/infinitelambda/scripts/claude_cost.sh\""
  },
  "enabledPlugins": {
    "oh-my-statusline@infinitelambda": true
  }
}
